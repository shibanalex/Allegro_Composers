# Settings of the backend. Copy to backend/.env for local development (that file is never committed);
# on hosting, the same names are set in the hosting's environment settings (see render.yaml).

# Signs login tokens: 32+ random characters, different for every site. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local SQLite by default; PostgreSQL on hosting (postgresql://user:password@host/db?sslmode=require)
DATABASE_URL=sqlite:///./allegro_platform.db

# Who may come in. While the community is invite-only: no sign-ups, only the listed usernames log in
REGISTRATION_OPEN=false
LOGIN_ALLOWLIST=

# Uploaded files: "local" keeps them in MEDIA_DIR; "s3" puts them into an S3-compatible bucket (Cloudflare R2)
STORAGE_BACKEND=local
MEDIA_DIR=media
MEDIA_URL_PREFIX=/media
# Only for STORAGE_BACKEND=s3; MEDIA_URL_PREFIX is then the bucket's public address (https://pub-....r2.dev)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=200

# A fresh deployed site: this code (16+ characters) opens the one-time /setup page for the first account
SETUP_TOKEN=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
