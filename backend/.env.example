# Settings of the backend. Copy to backend/.env for local development (that file is never committed);
# on hosting, the same names are set in the hosting's environment settings (see render.yaml).

# Signs login tokens: 32+ random characters, different for every site. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local SQLite by default; PostgreSQL on hosting (postgresql://user:password@host/db?sslmode=require)
DATABASE_URL=sqlite:///./allegro_platform.db

# Anyone may join; one address may open SIGNUPS_PER_HOUR accounts an hour.
# Password-reset links (made by an administrator) live RESET_LINK_TTL_HOURS.
SIGNUPS_PER_HOUR=5
RESET_LINK_TTL_HOURS=48

# E-mail addresses are optional and stored encrypted; the key is derived from SECRET_KEY unless set here.
# Changing either key makes stored addresses unreadable (accounts keep working).
EMAIL_ENCRYPTION_KEY=

# Uploaded files: "local" keeps them in MEDIA_DIR; "s3" puts them into an S3-compatible bucket (Yandex Object Storage, R2)
STORAGE_BACKEND=local
MEDIA_DIR=media
MEDIA_URL_PREFIX=/media
# Only for STORAGE_BACKEND=s3; MEDIA_URL_PREFIX is then the bucket public address (https://storage.yandexcloud.net/<bucket>)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=200

# A fresh deployed site: this code (16+ characters) opens the one-time /setup page for the first account
SETUP_TOKEN=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
